# Copy to .deploy.env (gitignored) and fill in. deploy.sh reads it.
DEPLOY_HOST=root@your.server
APP=my-wiki                                   # system user and /opt/<APP>
DOMAIN=wiki.example.com
PORT=8050
VAULT_REPO=git@github.com:you/your-vault.git  # private; the server gets a write deploy key
CERTBOT_EMAIL=you@example.com
WIKICORE_REPO=https://github.com/carlaost/wikicore.git
WIKICORE_REF=main
